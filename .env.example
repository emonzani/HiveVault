# HiveVault — configuration template. Copy to .env and edit.

# ---------------------------------------------------------------------------
# Database (docker compose: postgres on 5432, pgbouncer on 6432)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://brain:brain@127.0.0.1:5432/brain
POSTGRES_PASSWORD=brain
# Passphrase of the encrypted backup repository (pgBackRest). Empty = development default;
# scripts/install.sh generates one. Keep a copy outside the server: without it, no restore.
PGBACKREST_CIPHER_PASS=

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3700
# Public URL of the web app. Its host name is the WebAuthn relying party id (passkeys are
# bound to it: changing it later invalidates the registered passkeys). Clients of the signature
# login (CLI, edge devices) sign its origin.
PUBLIC_URL=http://localhost:3700
# WEBAUTHN_RP_ID=
# Extra origins accepted for passkeys and the signature login (e.g. the SPA dev server), comma separated
WEBAUTHN_EXTRA_ORIGINS=http://localhost:5310
# Built web app served at / (npm run web:build). Empty = API only.
WEB_DIR=packages/web/dist
# HTTPS: run scripts/dev-ca.sh <host or IP> and set the two files. Passkeys need HTTPS
# outside localhost.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Behind a reverse proxy: the addresses of the proxies (IP or CIDR range, comma separated), e.g.
# 127.0.0.1,::1 for a proxy on this server. The client IP is the last X-Forwarded-For address
# that is not a listed proxy. The proxy must overwrite X-Forwarded-For with the client address
# (nginx: proxy_set_header X-Forwarded-For $remote_addr). false = no proxy. The old value true
# is refused: the server does not start.
TRUST_PROXY=false
SESSION_IDLE_MINUTES=720
SESSION_MAX_HOURS=168
RATE_LIMIT_PER_MIN=600
LOGIN_RATE_LIMIT_PER_MIN=20
# PEM certificate of the company CA that issues client certificates (challenge login)
CLIENT_CA_FILE=
DATA_DIR=data

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
UPLOAD_MAX_MB=500
# Files uploaded by people are compiled into the wiki (I3); imports only on demand
COMPILE_UPLOADS=true
# How the chat model compiles a source: extract (one JSON extraction per part, merged into the
# pages by code) or agent (the model reads and writes the pages with tools: in docs/spikes about 17x
# the time and 30x the tokens of extract, same answers found)
COMPILE_MODE=extract
# Sources never asked to compile (bulk imports) are compiled while the chat model is free,
# one at a time, after uploads and questions. false: only the dream cycle compiles them.
IDLE_COMPILE=true
# Optional small chat models (4-8B) for the extraction of sources and the short answers of the
# dream cycle. The model of LLAMA_SERVER_URL then serves only the questions and the agent mode.
# Empty: LLAMA_SERVER_URL does all the work.
CHAT_EXTRACT_URLS=
CHAT_EXTRACT_PARALLELISM=1
# Durable task workers in the server process, and parser threads
INGEST_WORKERS=4
PARSER_THREADS=4
# Outgoing connections: database and model servers are always allowed. Add other hosts
# here (comma separated). Links that users import are allowed one download at a time.
EGRESS_ALLOW=
# Bulk import: folders (or mounted shares) under which imports may read, comma separated.
# Empty = imports from folders are disabled. Never include the data folder of the server.
IMPORT_ROOTS=

# ---------------------------------------------------------------------------
# Dream cycle (nightly maintenance and promotion to the hive)
# ---------------------------------------------------------------------------
DREAM_ENABLED=true
# Local time window "HH:MM-HH:MM"; the cycle pauses outside it and continues the next night
DREAM_WINDOW=22:00-06:00
# Budget per vault and night: minutes of work and chat-model tokens
DREAM_BUDGET_MINUTES=120
DREAM_BUDGET_TOKENS=300000
# Sources compiled (I3) per vault and night from the backlog
DREAM_COMPILE_PER_NIGHT=20
# Use the chat model for duplicate checks and summaries (false: deterministic steps only)
DREAM_USE_MODEL=true
# Documents added from a link are downloaded again by the dream cycle after these days; new
# content becomes a new version of the document (0 = never)
LINK_REFRESH_DAYS=7
# Links during the day: minutes between two passes that link, sync claims and promote to the hive
# the pages written since the last pass (no chat model). 0 = only the dream cycle does it
LINK_INTERVAL_MINUTES=5
# Retention of the security events of the audit log (minimum 183: 6 months) and of finished tasks, in days
AUDIT_RETENTION_DAYS=400
TASK_RETENTION_DAYS=30
# Retention of the read events of the audit log (who read what), in days; the console can change it
AUDIT_READ_RETENTION_DAYS=30
# Ingest email files (EML, MSG, MBOX); they become at least "riservato". The console can change it
INGEST_EMAIL=true

# ---------------------------------------------------------------------------
# Raw store encryption: 32 bytes in base64 (openssl rand -base64 32). Keep a copy outside
# the server: without it the original documents cannot be read. Empty in development: a
# key is generated in data/.master-key.
# ---------------------------------------------------------------------------
BRAIN_MASTER_KEY=

# ---------------------------------------------------------------------------
# Chat / compilation model
# ---------------------------------------------------------------------------
# URL of the llama-server of the chat model, in the company network (for example
# http://models.azienda.local:8000). Empty = no chat model: pages are not compiled by a model.
# The text sent here leaves this server: use only a host of your own network.
LLAMA_SERVER_URL=
# Model name reported by the server (informative)
LLAMA_MODEL_ID=local-model
LLAMA_PARALLELISM=1
LLAMA_MAX_TOKENS=16384
# Empty or 0 = read n_ctx from llama-server (GET /props)
LLAMA_CONTEXT_TOKENS=
LLAMA_TEMPERATURE=0.2
LLAMA_REQUEST_TIMEOUT_MS=1200000
LLAMA_IDLE_TIMEOUT_MS=180000
# A waiting request moves up one priority level every LLAMA_AGING_MS
LLAMA_AGING_MS=600000

# ---------------------------------------------------------------------------
# Embedding and reranker (CPU). The model must be the same on every endpoint.
# ---------------------------------------------------------------------------
EMBED_MODEL_ID=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_DIMENSIONS=1024
RERANK_MODEL_ID=Qwen3-Reranker-0.6B-Q8_0.gguf

# Local mode: the server starts and supervises its own llama-server processes
LOCAL_MODELS_ENABLED=false
LOCAL_LLAMA_BIN=llama-server
LOCAL_MODELS_DIR=data/models
LOCAL_EMBED_PORT=18001
LOCAL_RERANK_PORT=18002
# Upper limit of CPU threads, so that Postgres and the parsers stay responsive
LOCAL_MODELS_THREADS=8
# always | off-hours | on-demand
LOCAL_MODELS_SCHEDULE=always
LOCAL_MODELS_OFF_HOURS=19:00-07:00
# Extra llama-server arguments. "--device none" keeps a CUDA build on the CPU (no batch offload).
LOCAL_LLAMA_EXTRA_ARGS=--device none

# Remote mode: zero or more endpoints, comma separated
REMOTE_EMBED_URLS=
REMOTE_RERANK_URLS=
# OCR of scans and photos: vision endpoints (llama-server with --mmproj, or SGLang with
# Baidu Unlimited-OCR). Empty: images and scanned PDFs keep the warning "needs_ocr".
OCR_URLS=
# generic | unlimited-ocr (the fixed prompt of Unlimited-OCR)
OCR_PROMPT=generic
OCR_PAGES_PER_REQUEST=4
OCR_RENDER_SCALE=2
OCR_MAX_PAGES=500
# Optional bearer token for remote llama-server (--api-key)
MODELS_API_KEY=

# mock = deterministic fake models (development); queue = wait until an endpoint is up
MODELS_OFFLINE_MODE=mock

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# MCP server for the cloud agent (POST /mcp)
# ---------------------------------------------------------------------------
# Results of brain_search re-scored by the reranker: 20 = best recall (5 s on CPU), 10 = half
# the latency with a small loss (phase 6 eval)
MCP_RERANK_TOP=20

# ---------------------------------------------------------------------------
# Metrics and dashboards (phase 7)
# ---------------------------------------------------------------------------
# Bearer token for a Prometheus scraper at GET /metrics. Empty = administrators only.
METRICS_TOKEN=
